# CBT Bulldozer Local Server Configuration
# Copy this file to .env and fill in your values

# Port for the local server (default: 3001)
PORT=3001

# Your deployed CBT API URL (Replit, VPS, etc.)
# The local server will proxy all /api/* calls to this URL
# Example: https://your-app.replit.app
API_TARGET=https://your-replit-app.repl.co

# Optional: Gemini API key (can also be set in the app's SuperAdmin UI)
GEMINI_API_KEY=
