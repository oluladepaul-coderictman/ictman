# CBT Bulldozer hosted deployment
# Copy this file to .env locally and fill in values.
# Never commit .env or paste secret values into GitHub.

# Required by the API server
DATABASE_URL=postgresql://user:password@host:5432/database
SESSION_SECRET=replace-with-a-long-random-secret
PORT=8080

# SuperAdmin bootstrap password
SUPERADMIN_PASSWORD=replace-with-a-strong-password

# Optional AI provider — if set, Groq is selected automatically.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Replit AI integration variables, when used by the workspace.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Local phi model
# Place phi3-mini.gguf in models/ locally or provide it through deployment storage.